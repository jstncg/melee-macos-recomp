+// Native OS vector services for the validated GALE01 revision 2 build.
+// The game installs copies below its DOL. Verify the installed instructions
+// against their original DOL templates before handling them natively.
+bool StaticRecompCore::HandleMeleeVector()
+{
+  if (!m_module || std::string_view(m_module->game_id) != "GALE01")
+    return false;
+  auto& ppc = m_system.GetPPCState();
+  const u32 vector = ppc.pc & ~0x80000000u;
+  static constexpr u32 vectors[] = {0x100,0x200,0x300,0x400,0x500,0x600,0x700,
+                                   0x800,0x900,0xc00,0xd00,0xf00,0x1300,0x1400,0x1700};
+  int number = -1;
+  for (int i = 0; i < 15; ++i)
+    if (vector == vectors[i]) number = i;
+  if (number < 0 || !m_guest.ram || m_guest.ram_size < 0x34aba0)
+    return false;
+  const auto read = [this](u32 address) {
+    const u8* p = m_guest.ram + address;
+    return (u32(p[0]) << 24) | (u32(p[1]) << 16) | (u32(p[2]) << 8) | p[3];
+  };
+  const bool syscall = vector == 0xc00;
+  const u32 source = syscall ? 0x34ab80 : 0x3435e4;
+  const u32 length = syscall ? 0x1c : 0x98;
+  for (u32 offset = 0; offset < length; offset += 4)
+  {
+    u32 expected = read(source + offset);
+    if (!syscall && offset == 0x68) expected = (expected & 0xffff0000u) | u32(number);
+    if (read(vector + offset) != expected)
+      return false;
+  }
+  SyncIn();
+  if (syscall)
+  {
+    m_guest.gpr[9] = HookSPRRead(&m_guest, SPR_HID0, vector);
+    m_guest.gpr[10] = m_guest.gpr[9] | 8u;
+    HookSPRWrite(&m_guest, SPR_HID0, m_guest.gpr[10], vector + 8);
+    HookSPRWrite(&m_guest, SPR_HID0, m_guest.gpr[9], vector + 20);
+  }
+  else
+  {
+    // Straight-line translation of OSExceptionVector in the supplied decomp.
+    const u32 old_r4 = m_guest.gpr[4];
+    HookSPRWrite(&m_guest, SPR_SPRG0, old_r4, vector);
+    m_guest.gpr[4] = u32(HookExternalRead(&m_guest, 0xc0, 4));
+    const u32 context = m_guest.gpr[4];
+    HookExternalWrite(&m_guest, context + 12, m_guest.gpr[3], 4);
+    HookExternalWrite(&m_guest, context + 16, old_r4, 4);
+    HookExternalWrite(&m_guest, context + 20, m_guest.gpr[5], 4);
+    HookExternalWrite(&m_guest, context + 418, HookExternalRead(&m_guest, context + 418, 2) | 2u, 2);
+    HookExternalWrite(&m_guest, context + 128, m_guest.cr, 4);
+    HookExternalWrite(&m_guest, context + 132, m_guest.lr, 4);
+    HookExternalWrite(&m_guest, context + 136, m_guest.ctr, 4);
+    HookExternalWrite(&m_guest, context + 140, m_guest.xer, 4);
+    HookExternalWrite(&m_guest, context + 408, m_guest.srr0, 4);
+    HookExternalWrite(&m_guest, context + 412, m_guest.srr1, 4);
+    const bool recoverable = (m_guest.srr1 & 2u) != 0;
+    m_guest.srr1 = m_guest.msr | 0x30u;
+    m_guest.gpr[3] = u32(number);
+    m_guest.gpr[4] = u32(HookExternalRead(&m_guest, 0xd4, 4));
+    m_guest.cr = (m_guest.cr & 0x0fffffffu) |
+      ((recoverable ? 4u : 2u) | ((m_guest.xer >> 31) & 1u)) << 28;
+    m_guest.gpr[5] = recoverable ? u32(HookExternalRead(&m_guest, 0x3000 + 4u * number, 4)) : 0x80343680u;
+    m_guest.srr0 = m_guest.gpr[5];
+  }
+  // rfi semantics: restore SRR1's defined bits, clear POW, branch to SRR0.
+  m_guest.msr = ((m_guest.msr & ~0x87c0ffffu) | (m_guest.srr1 & 0x87c0ffffu)) & ~0x00040000u;
+  m_guest.pc = m_guest.srr0 & ~3u;
+  m_guest.downcount = -(syscall ? 12 : 38);
+  SyncOut();
+  ++m_native_dispatches;
+  return true;
+}
