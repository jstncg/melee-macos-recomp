Subject: keep virtual joysticks enabled when HIDAPI is disabled

Apply inside the SDL submodule. The virtual driver has no HIDAPI dependency.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b01acc3bc..a4b630a29 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -382,7 +382,7 @@ dep_option(SDL_HIDAPI              "Enable the HIDAPI subsystem" ON "NOT VISIONO
 dep_option(SDL_HIDAPI_LIBUSB       "Use libusb for low level joystick drivers" ON "SDL_HIDAPI;SDL_HIDAPI_LIBUSB_AVAILABLE" OFF)
 dep_option(SDL_HIDAPI_LIBUSB_SHARED "Dynamically load libusb support" ON "SDL_HIDAPI_LIBUSB;SDL_DEPS_SHARED" OFF)
 dep_option(SDL_HIDAPI_JOYSTICK     "Use HIDAPI for low level joystick drivers" ON SDL_HIDAPI OFF)
-dep_option(SDL_VIRTUAL_JOYSTICK    "Enable the virtual-joystick driver" ON SDL_HIDAPI OFF)
+option(SDL_VIRTUAL_JOYSTICK        "Enable the virtual-joystick driver" ON)
 set_option(SDL_LIBUDEV             "Enable libudev support" ON)
 set_option(SDL_ASAN                "Use AddressSanitizer to detect memory errors" OFF)
 set_option(SDL_CCACHE              "Use Ccache to speed up build" OFF)
